+// A theme cursor (hyprcursor/xcursor) is CPU memory, usually in exactly the
+// share buffer's format and size: copy it straight into a shm share buffer.
+// Returns false when the cursor has to be rendered instead (client cursor
+// surfaces, dmabuf buffers, permission or position decide otherwise).
+static bool copyThemeCursorToShm(SP<IHLBuffer> buffer, wl_client* client, const FSourceBoxCallback& sourceBox) {
+    const auto& cursorImage = Pointer::mgr()->currentCursorImage();
+    if (!cursorImage.pBuffer)
+        return false;
+
+    if (g_pDynamicPermissionManager->clientPermissionMode(client, PERMISSION_TYPE_CURSOR_POS) != PERMISSION_RULE_ALLOW_MODE_ALLOW ||
+        !Pointer::mgr()->getCursorBoxGlobal().overlaps(sourceBox()))
+        return false;
+
+    const auto SRC = cursorImage.pBuffer->shm();
+    const auto DST = buffer->shm();
+    if (!SRC.success || !DST.success || SRC.format != DRM_FORMAT_ARGB8888 || DST.format != SRC.format || SRC.size != DST.size)
+        return false;
+
+    auto [srcData, srcFormat, srcLen] = cursorImage.pBuffer->beginDataPtr(0);
+    auto [dstData, dstFormat, dstLen] = buffer->beginDataPtr(0);
+    if (srcData && dstData) {
+        const size_t ROW = sc<size_t>(SRC.size.x) * 4;
+        for (int y = 0; y < SRC.size.y; ++y)
+            std::memcpy(dstData + sc<size_t>(y) * DST.stride, srcData + sc<size_t>(y) * SRC.stride, ROW);
+    }
+    cursorImage.pBuffer->endDataPtr();
+    buffer->endDataPtr();
+    return srcData && dstData;
+}
